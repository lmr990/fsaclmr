<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qutms_eufs_bridge</name>
  <version>0.1.0</version>
  <description>Launch-only integration package for the direct QUTMS controller to eufs_sim control interface.</description>
  <maintainer email="team@qutmotorsport.com">QUT Motorsport</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controllers</exec_depend>
  <exec_depend>eufs_launcher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>yolo_cone_detection</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>