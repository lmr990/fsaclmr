<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>webcam_path_demo</name>
    <version>0.1.0</version>
    <description>Real-webcam cone detection + path planning demo: YOLO cones from a laptop
        camera, monocular distance estimation, ft_planner midline overlaid on the live image.</description>
    <maintainer email="team@qutmotorsport.com">QUTMS Demo</maintainer>
    <license>MIT</license>

    <depend>rclpy</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>std_msgs</depend>
    <depend>driverless_msgs</depend>
    <depend>cv_bridge</depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
